# Copy this file to .env and fill in your values

# OpenAI API key (used for DALL-E 3 thumbnail generation)
OPENAI_API_KEY=your-openai-api-key-here

# RocketRide pipeline engine — the SDK uses ${ROCKETRIDE_OPENAI_KEY} inside .pipe files
# Set this to the same value as OPENAI_API_KEY
ROCKETRIDE_OPENAI_KEY=your-openai-api-key-here

# RocketRide server URI (auto-detected from VS Code extension if not set)
# ROCKETRIDE_URI=http://127.0.0.1:5565

# RocketRide API key (auto-read from VS Code extension state if not set)
# ROCKETRIDE_APIKEY=your-rocketride-api-key-here
